---
import { capabilities, img, srcset } from '../data/content';
---

<section id="sobre-mi" class="wrap about">
  <figure>
    <img
      src={img('retrato')}
      srcset={srcset('retrato')}
      sizes="(max-width: 860px) 100vw, 380px"
      width="1280"
      height="1600"
      alt="Leinerke, fotógrafo y filmmaker, sentado con su cámara Sony"
      loading="lazy"
    />
  </figure>
  <div>
    <p class="eyebrow">[ 03 / Sobre mí ]</p>
    <h2>Dos mundos, la misma obsesión por el cuadro perfecto<span class="dot">.</span></h2>
    <div class="bio">
      <p>
        Soy fotógrafo y filmmaker en Medellín. En la pista busco el segundo exacto del salto; en la cocina, el instante en que el plato se ve mejor. Las dos cosas piden lo mismo: anticipación.
      </p>
      <p>Hago la producción completa: idea, fotografía, video, edición y color. Tú recibes contenido listo para publicar.</p>
    </div>
    <ul class="caps">
      {
        capabilities.map((c, i) => (
          <li>
            <span class="meta n">[ 0{i + 1} ]</span>
            <span class="t">{c.title}</span>
            <span class="d">{c.desc}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 380px) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
    padding-block: var(--section);
    border-top: 1px solid var(--line);
  }
  figure {
    margin: 0;
  }
  figure img {
    width: 100%;
    background: var(--ph);
  }
  .eyebrow {
    margin-bottom: 14px;
  }
  h2 {
    max-width: 16ch;
    font-size: clamp(34px, 4.6vw, 64px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .bio {
    margin-top: 28px;
    max-width: 58ch;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted);
  }
  .caps {
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .caps li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .n {
    color: var(--accent);
  }
  .t {
    font-size: 17px;
  }
  .d {
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 860px) {
    .about {
      grid-template-columns: 1fr;
    }
    figure {
      max-width: 420px;
    }
  }
</style>
