---
import { brands, wa, WHATSAPP_DISPLAY, type Mode } from '../data/content';
const modes: Mode[] = ['studio', 'raw'];
---

<section id="contacto" class="contact">
  <div class="wrap inner">
    <p class="eyebrow">[ 04 / Contacto ]</p>
    {modes.map((m) => <h2 data-only={m}>{brands[m].ctaTitle}<span class="dot">?</span></h2>)}
    <p class="lead">Escríbeme por WhatsApp y cuéntame qué necesitas. Te respondo con una propuesta.</p>
    <div class="actions">
      {
        modes.map((m) => (
          <a class="btn btn-accent big" data-only={m} href={wa(brands[m].waMsg)} target="_blank" rel="noopener">
            Escríbeme por WhatsApp →
          </a>
        ))
      }
      <a href={"tel:" + WHATSAPP_DISPLAY}><span class="meta phone">{WHATSAPP_DISPLAY}</span></a>
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--line);
  }
  .inner {
    padding-block: var(--section);
  }
  .eyebrow {
    margin-bottom: 14px;
  }
  h2 {
    max-width: 14ch;
    font-size: clamp(40px, 6.4vw, 96px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .lead {
    margin-top: 24px;
    max-width: 48ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--muted);
  }
  .actions {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
  }
  .big {
    min-height: 56px;
    padding: 0 28px;
  }
  .phone {
    font-size: 13px;
  }
</style>
