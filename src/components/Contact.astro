---
import { brands, wa, WHATSAPP, WHATSAPP_DISPLAY, type Mode } from '../data/content';
const modes: Mode[] = ['studio', 'raw'];
---

<!-- Banda oscura de cierre: el papel cambia, la acción es WhatsApp -->
<section id="contacto" class="contact">
  <div class="wrap inner">
    {modes.map((m) => <h2 class="reveal" data-only={m}>{brands[m].ctaTitle}?</h2>)}
    <p class="lead reveal" style="--d: 100ms">Escríbeme por WhatsApp y cuéntame qué necesitas. Te respondo con una propuesta.</p>
    <div class="actions reveal" style="--d: 200ms">
      {
        modes.map((m) => (
          <a class="btn cta" data-only={m} href={wa(brands[m].waMsg)} target="_blank" rel="noopener">
            Escríbeme por WhatsApp
          </a>
        ))
      }
      <a class="phone" href={`tel:+${WHATSAPP}`}>{WHATSAPP_DISPLAY}</a>
    </div>
  </div>
</section>

<style>
  .contact {
    background: var(--band);
    color: var(--band-fg);
    transition: background-color 400ms var(--ease);
  }
  .inner {
    padding-block: var(--space-10);
  }
  h2 {
    max-width: 18ch;
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.75rem);
    line-height: 1.04;
  }
  .lead {
    margin-top: var(--space-5);
    max-width: 46ch;
    font-size: var(--text-lede);
    color: var(--band-muted);
  }
  .actions {
    margin-top: var(--space-7);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
  .cta {
    background: var(--band-accent);
    border-color: var(--band-accent);
    color: var(--brand-carbon);
  }
  .cta:hover {
    background: var(--band-fg);
    border-color: var(--band-fg);
  }
  .phone {
    font-weight: 700;
    color: var(--band-fg);
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .phone:hover {
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
