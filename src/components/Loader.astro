---
import { asset } from '../data/content';
---

<!-- Pantalla de carga: al abrir la web y al pasar de una página a otra.
     Sin JavaScript se retira sola con una animación CSS, nunca deja la página tapada. -->
<div class="loader" aria-hidden="true">
  <img src={asset('brand/logo-leinerke-studio-sin-margen.svg')} alt="" data-only="studio" width="220" height="39" />
  <img src={asset('brand/logo-leinerke-raw-blanco-sin-margen.svg')} alt="" data-only="raw" width="220" height="39" />
  <span class="bar"></span>
</div>

<style>
  .loader[hidden] {
    display: none;
  }
  .loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    background: var(--bg);
    animation: loader-out 450ms var(--ease) 2.4s forwards;
  }
  .loader img {
    width: min(220px, 56vw);
    height: auto;
    animation: loader-in 700ms var(--ease) both;
  }
  .bar {
    position: relative;
    width: min(220px, 56vw);
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }
  .bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform-origin: left;
    animation: loader-bar 1.1s var(--ease) infinite;
  }
  /* Con JavaScript, la pantalla se retira apenas la página está lista */
  :global(.js) .loader {
    animation: none;
    transition: opacity 450ms var(--ease), visibility 0s linear 450ms;
  }
  :global(.js[data-loaded]) .loader {
    opacity: 0;
    visibility: hidden;
  }
  :global(.js[data-leaving]) .loader,
  :global(.js[data-switching]) .loader {
    opacity: 1;
    visibility: visible;
    transition: opacity 300ms var(--ease);
  }
  @keyframes loader-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  @keyframes loader-bar {
    0% {
      transform: translateX(-100%) scaleX(0.4);
    }
    100% {
      transform: translateX(100%) scaleX(0.4);
    }
  }
  @keyframes loader-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bar::after {
      animation: none;
      transform: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const loader = document.querySelector<HTMLElement>('.loader')!;
  const start = performance.now();
  const MIN = 600; // lo justo para ver la marca, sin hacer esperar
  const MAX = 2400;

  const done = () => {
    if (root.dataset.loaded) return;
    root.dataset.loaded = '1';
    document.dispatchEvent(new Event('loader:done'));
    // Tras el desvanecido, se retira del todo para no tapar nada
    setTimeout(() => {
      if (!root.dataset.leaving) loader.hidden = true;
    }, 500);
  };
  const finish = () => setTimeout(done, Math.max(0, MIN - (performance.now() - start)));
  if (document.readyState === 'complete') finish();
  else window.addEventListener('load', finish, { once: true });
  setTimeout(done, MAX);

  // Al ir a otra página del sitio, la pantalla vuelve a cubrir mientras carga
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[href]');
    if (!a || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    if (a.target === '_blank' || a.hasAttribute('download')) return;
    const url = new URL(a.href, location.href);
    if (url.origin !== location.origin || (url.pathname === location.pathname && url.search === location.search)) return;
    e.preventDefault();
    loader.hidden = false;
    void loader.offsetWidth;
    root.dataset.leaving = '1';
    setTimeout(() => (location.href = url.href), 300);
  });
  // Al cambiar de submarca: cubrir, aplicar el cambio y descubrir
  const SHOW = 300;
  const HOLD = 550;
  document.addEventListener('loader:switch', (e) => {
    const apply = (e as CustomEvent<() => void>).detail;
    loader.hidden = false;
    void loader.offsetWidth;
    root.dataset.switching = '1';
    setTimeout(() => {
      apply();
      setTimeout(() => {
        delete root.dataset.switching;
        setTimeout(() => {
          if (!root.dataset.switching && !root.dataset.leaving) loader.hidden = true;
        }, 500);
      }, HOLD);
    }, SHOW);
  });

  // Al volver con el botón atrás, la página viene de la caché: quitar la pantalla
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      delete root.dataset.leaving;
      loader.hidden = true;
      done();
    }
  });
</script>
