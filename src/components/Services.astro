---
import { brands, wa, type Mode } from '../data/content';
const modes: Mode[] = ['studio', 'raw'];
---

<!-- Pozo tintado: la única sección con fondo propio antes del cierre -->
<section id="servicios" class="services">
  <div class="wrap">
    {modes.map((m) => <h2 class="section-title" data-only={m}>{brands[m].servicesTitle}</h2>)}
    {
      modes.map((m) => (
        <div class="list" data-only={m}>
          {brands[m].services.map((s) => (
            <article class="row">
              <div>
                <h3>{s.title}</h3>
                <p class="desc">{s.desc}</p>
              </div>
              <ul>
                {s.items.map((d) => <li>{d}</li>)}
              </ul>
              <a class="btn btn-line quote" href={wa(`Hola Leinerke, quiero cotizar: ${s.title}.`)} target="_blank" rel="noopener">
                Cotizar
              </a>
            </article>
          ))}
        </div>
      ))
    }
  </div>
</section>

<style>
  .services {
    background: var(--well);
    padding-block: var(--space-10);
    transition: background-color 400ms var(--ease);
  }
  .list {
    margin-top: var(--space-8);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) auto;
    gap: var(--space-6) var(--space-7);
    align-items: start;
    padding-block: var(--space-6);
    border-top: 1px solid var(--line);
  }
  h3 {
    font-size: var(--text-title);
    line-height: 1.2;
  }
  .desc {
    margin-top: var(--space-3);
    max-width: 52ch;
    color: var(--muted);
  }
  ul {
    margin: 0;
    padding: 0 0 0 var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  li::marker {
    color: var(--accent);
  }
  .quote {
    min-height: 44px;
    justify-self: start;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>
