---
import { brands, wa } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="footer">
  <div class="wrap row">
    <span>© {new Date().getFullYear()} Leinerke, Medellín</span>
    <span class="links">
      <a href={brands.studio.instagram} target="_blank" rel="noopener">@leinerke.studio</a>
      <a href={brands.raw.instagram} target="_blank" rel="noopener">@leinerke.raw</a>
      <a href={`${base}/marca/`}>Manual de marca</a>
    </span>
  </div>
</footer>

<a class="fab" data-only="studio" href={wa(brands.studio.waMsg)} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.6-.1 1.8-.7 2-1.5.2-.7.2-1.4.2-1.5-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"></path></svg>
</a>
<a class="fab" data-only="raw" href={wa(brands.raw.waMsg)} target="_blank" rel="noopener" aria-label="Escríbeme por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5 2.5 1 3 .8 3.6.8.6-.1 1.8-.7 2-1.5.2-.7.2-1.4.2-1.5-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"></path></svg>
</a>

<style>
  .footer {
    background: var(--band);
    color: var(--band-muted);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: var(--text-small);
    transition: background-color 400ms var(--ease);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding-block: var(--space-5) var(--space-9);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-5);
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
  }
  .links a:hover {
    color: var(--band-fg);
  }
  .fab {
    position: fixed;
    right: var(--space-5);
    bottom: var(--space-5);
    z-index: 30;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms var(--ease);
  }
  .fab:hover {
    transform: scale(1.06);
  }
</style>
