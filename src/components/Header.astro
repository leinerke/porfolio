---
import { brands, wa, asset } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['Portafolio', `${base}/#portafolio`],
  ['Servicios', `${base}/#servicios`],
  ['Sobre mí', `${base}/#sobre-mi`],
];
---

<header class="header">
  <div class="wrap bar">
    <a href={`${base}/`} class="logo" aria-label="LEINERKE, inicio">
      <img src={asset('brand/logo-leinerke-studio-sin-margen.svg')} alt="LEINERKE STUDIO" data-only="studio" width="147" height="26" />
      <img src={asset('brand/logo-leinerke-raw-blanco-sin-margen.svg')} alt="LEINERKE RAW" data-only="raw" width="147" height="26" />
    </a>

    <div class="toggle" role="group" aria-label="Submarca">
      <button type="button" data-set-mode="studio" aria-pressed="true">.studio</button>
      <button type="button" data-set-mode="raw" aria-pressed="false">.raw</button>
    </div>

    <nav class="links" aria-label="Principal">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="btn btn-accent cta" data-only="studio" href={wa(brands.studio.waMsg)} target="_blank" rel="noopener">Cotizar</a>
      <a class="btn btn-accent cta" data-only="raw" href={wa(brands.raw.waMsg)} target="_blank" rel="noopener">Cotizar</a>
    </nav>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
        <line class="l1" x1="4" y1="8" x2="24" y2="8" />
        <line class="l2" x1="4" y1="14" x2="24" y2="14" />
        <line class="l3" x1="4" y1="20" x2="24" y2="20" />
      </svg>
    </button>
  </div>

  <nav id="menu-movil" class="wrap mobile" aria-label="Menú" hidden>
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
    <a class="btn btn-accent" data-only="studio" href={wa(brands.studio.waMsg)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
    <a class="btn btn-accent" data-only="raw" href={wa(brands.raw.waMsg)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: background-color 400ms var(--ease);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }
  .logo img {
    height: 26px;
    width: auto;
  }
  .toggle {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .toggle button {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 300ms var(--ease), color 300ms var(--ease);
  }
  .toggle button:hover {
    color: var(--fg);
  }
  .toggle button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: 0.9375rem;
  }
  .links a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .links a:not(.btn):hover {
    color: var(--fg);
  }
  .cta {
    min-height: 44px;
    padding: 0 var(--space-5);
    font-size: 0.9375rem;
  }
  .menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-right: calc(var(--space-2) * -1);
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    cursor: pointer;
  }
  /* Tres rayas que se vuelven una X */
  .menu-btn line {
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    transform-origin: 14px 14px;
    transition: transform 350ms var(--ease), opacity 200ms var(--ease);
  }
  /* Primero baja/sube al centro y luego gira: así las dos rayas se cruzan justo en el medio */
  .menu-btn[aria-expanded='true'] .l1 {
    transform: rotate(45deg) translateY(6px);
  }
  .menu-btn[aria-expanded='true'] .l2 {
    opacity: 0;
    transform: scaleX(0.2);
  }
  .menu-btn[aria-expanded='true'] .l3 {
    transform: rotate(-45deg) translateY(-6px);
  }
  /* El menú abierto ocupa toda la pantalla bajo el header: nada de la página asoma debajo */
  .mobile {
    position: fixed;
    top: 69px;
    left: 0;
    right: 0;
    bottom: 0;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    padding-block: var(--space-4) var(--space-7);
    background: var(--bg);
    border-top: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile:not([hidden]) {
    animation: drop 350ms var(--ease);
  }
  .mobile:not([hidden]) a {
    animation: rise 450ms var(--ease) both;
  }
  .mobile:not([hidden]) a:nth-child(2) {
    animation-delay: 50ms;
  }
  .mobile:not([hidden]) a:nth-child(3) {
    animation-delay: 100ms;
  }
  .mobile:not([hidden]) a:nth-child(n + 4) {
    animation-delay: 150ms;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .mobile a:not(.btn) {
    padding: var(--space-3) 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mobile .btn {
    margin-top: var(--space-4);
  }

  @media (max-width: 800px) {
    .links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 400px) {
    .logo img {
      height: 21px;
    }
    .toggle button {
      padding: 0 var(--space-3);
    }
  }
</style>

<script>
  import '../scripts/mode';
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('menu-movil')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  // Con el menú abierto, la página de fondo no se desplaza. Se bloquea en <html>
  // (no en <body>): así el header sigue fijo arriba y no se mueve con la página.
  const header = document.querySelector<HTMLElement>('.header')!;
  new MutationObserver(() => {
    const open = !menu.hidden;
    if (open) menu.style.top = `${Math.round(header.getBoundingClientRect().bottom)}px`;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  }).observe(menu, { attributes: true, attributeFilter: ['hidden'] });
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('modechange', () => setOpen(false));
</script>
