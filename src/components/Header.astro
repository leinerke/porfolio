---
import { brands, wa, asset } from '../data/content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = [
  ['Portafolio', `${base}/#portafolio`],
  ['Servicios', `${base}/#servicios`],
  ['Sobre mí', `${base}/#sobre-mi`],
];
---

<header class="header">
  <div class="wrap bar">
    <a href={`${base}/`} class="logo" aria-label="LEINERKE, inicio">
      <img src={asset('brand/logo-leinerke-sin-margen.svg')} alt="LEINERKE" data-only="studio" width="154" height="14" />
      <img src={asset('brand/logo-leinerke-blanco-sin-margen.svg')} alt="LEINERKE" data-only="raw" width="154" height="14" />
    </a>

    <div class="toggle" role="group" aria-label="Submarca">
      <button type="button" data-set-mode="studio" aria-pressed="true">.studio</button>
      <button type="button" data-set-mode="raw" aria-pressed="false">.raw</button>
    </div>

    <nav class="links" aria-label="Principal">
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
      <a class="btn btn-accent cta" data-only="studio" href={wa(brands.studio.waMsg)} target="_blank" rel="noopener">Cotizar</a>
      <a class="btn btn-accent cta" data-only="raw" href={wa(brands.raw.waMsg)} target="_blank" rel="noopener">Cotizar</a>
    </nav>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="menu-movil">Menú</button>
  </div>

  <nav id="menu-movil" class="wrap mobile" aria-label="Menú" hidden>
    {links.map(([label, href]) => <a href={href}>{label}</a>)}
    <a class="btn btn-accent" data-only="studio" href={wa(brands.studio.waMsg)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
    <a class="btn btn-accent" data-only="raw" href={wa(brands.raw.waMsg)} target="_blank" rel="noopener">Cotizar por WhatsApp</a>
  </nav>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    transition: background-color 400ms var(--ease);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 68px;
  }
  .logo {
    display: flex;
    align-items: center;
    min-height: 44px;
    flex-shrink: 0;
  }
  .logo img {
    height: 14px;
    width: auto;
  }
  .toggle {
    display: flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 3px;
    font-size: var(--text-small);
    font-weight: 700;
  }
  .toggle button {
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: background-color 300ms var(--ease), color 300ms var(--ease);
  }
  .toggle button:hover {
    color: var(--fg);
  }
  .toggle button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .links {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: 0.9375rem;
  }
  .links a:not(.btn) {
    color: var(--muted);
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  .links a:not(.btn):hover {
    color: var(--fg);
  }
  .cta {
    min-height: 44px;
    padding: 0 var(--space-5);
    font-size: 0.9375rem;
  }
  .menu-btn {
    display: none;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    border: 0;
    background: transparent;
    cursor: pointer;
    font-weight: 700;
  }
  .mobile {
    display: flex;
    flex-direction: column;
    padding-block: var(--space-2) var(--space-6);
    border-top: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile a:not(.btn) {
    padding: var(--space-3) 0;
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .mobile .btn {
    margin-top: var(--space-4);
  }

  @media (max-width: 800px) {
    .links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 400px) {
    .logo img {
      height: 11px;
    }
    .toggle button {
      padding: 0 var(--space-3);
    }
  }
</style>

<script>
  import '../scripts/mode';
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
  const menu = document.getElementById('menu-movil')!;
  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.textContent = open ? 'Cerrar' : 'Menú';
  };
  btn.addEventListener('click', () => setOpen(menu.hidden));
  menu.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('modechange', () => setOpen(false));
</script>
