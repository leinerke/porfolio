---
import { brands, img, srcset, wa, type Mode } from '../data/content';
const modes: Mode[] = ['studio', 'raw'];
---

<div id="inicio">
{
  modes.map((m) => {
    const b = brands[m];
    return (
      <section class="wrap hero" data-only={m}>
        <div class="text">
          <p class="eyebrow">[ {b.eyebrow} ]</p>
          <h1>{b.headline}<span class="dot">.</span></h1>
          <p class="sub">{b.sub}</p>
          <div class="actions">
            <a class="btn btn-solid" href="#portafolio">Ver portafolio</a>
            <a class="btn btn-line" href={wa(b.waMsg)} target="_blank" rel="noopener">
              Cotizar por WhatsApp
            </a>
          </div>
        </div>
        <figure>
          <img
            src={img(b.hero.src)}
            srcset={srcset(b.hero.src)}
            sizes="(max-width: 640px) 100vw, 576px"
            width={b.hero.w}
            height={b.hero.h}
            alt={b.hero.alt}
            fetchpriority={m === 'studio' ? 'high' : 'auto'}
          />
          <figcaption class="meta">[ {b.hero.meta} ]</figcaption>
        </figure>
      </section>
    );
  })
}
</div>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(32px, 5vw, 80px);
    padding-block: clamp(32px, 5vw, 64px);
  }
  .text {
    flex: 1 1 300px;
    min-width: 0;
  }
  .eyebrow {
    margin-bottom: 24px;
  }
  h1 {
    max-width: 14ch;
    font-size: clamp(40px, 5.8vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .sub {
    margin-top: 28px;
    max-width: 460px;
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.5;
    color: var(--muted);
  }
  .actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  figure {
    flex: 1 1 260px;
    max-width: 576px;
    margin: 0;
  }
  figure img {
    width: 100%;
    background: var(--ph);
  }
  figcaption {
    padding-top: 12px;
  }
  @media (max-width: 640px) {
    figure {
      max-width: none;
    }
    .actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
