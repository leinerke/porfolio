---
import { brands, img, srcset, wa, type Mode } from '../data/content';
const modes: Mode[] = ['studio', 'raw'];
---

<div id="inicio">
  {
    modes.map((m) => {
      const b = brands[m];
      return (
        <section class="wrap hero" data-only={m}>
          <div class="text">
            <h1>{b.headline}</h1>
            <p class="lede">{b.sub}</p>
            <div class="actions">
              <a class="btn btn-accent" href={wa(b.waMsg)} target="_blank" rel="noopener">
                Cotizar por WhatsApp
              </a>
              <a class="link" href="#portafolio">Ver portafolio</a>
            </div>
          </div>
          <figure>
            <img
              src={img(b.hero.src)}
              srcset={srcset(b.hero.src)}
              sizes="(max-width: 760px) 100vw, 46vw"
              width={b.hero.w}
              height={b.hero.h}
              alt={b.hero.alt}
              fetchpriority={m === 'studio' ? 'high' : 'auto'}
            />
            <figcaption>{b.hero.meta}</figcaption>
          </figure>
        </section>
      );
    })
  }
</div>

<style>
  /* Ledge: texto a la izquierda, la foto completa (sin recortar) a la derecha, todo dentro de una pantalla */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 36rem) auto;
    justify-content: space-evenly;
    align-items: center;
    gap: clamp(var(--space-6), 5vw, var(--space-9));
    /* Una pantalla, con tope para monitores muy altos */
    min-height: min(calc(100svh - 69px), 960px);
    padding-block: var(--space-6);
  }
  .text {
    max-width: 36rem;
  }
  h1 {
    font-size: var(--text-hero);
    line-height: 1.04;
  }
  .lede {
    margin-top: var(--space-5);
    max-width: 44ch;
    font-size: var(--text-lede);
    line-height: 1.55;
    color: var(--muted);
  }
  .actions {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
  }
  figure {
    margin: 0;
    /* El alto manda: la foto 4:5 entra entera en la pantalla y conserva su formato */
    width: min(46vw, calc((100svh - 69px - 7rem) * 0.8), 600px);
  }
  figure img {
    width: 100%;
    background: var(--ph);
  }
  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-small);
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      padding-block: var(--space-7) var(--space-6);
    }
    figure {
      width: 100%;
    }
  }
</style>
